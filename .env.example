# 复制本文件为 .env 后填入你自己的密钥：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，请勿提交到仓库

# --- 对话大模型（必填）---
# 用于生成 AI 角色的回复。未填写时页面可正常打开，但 AI 不会说话。
ZHIPU_API_KEY=

# --- 语音识别 ASR（可选）---
# 用于把用户语音转成文字。留空时文字聊天仍可用，语音输入不可用。
# 申请地址：https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=

# --- 服务端口（可选）---
# 仅在使用 uvicorn 直接启动时生效；Docker 镜像固定监听 80。
# PORT=8000
