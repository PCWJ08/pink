# 统一换行符：仓库内一律 LF，避免 Windows 与 macOS 协作时整份文件 diff
* text=auto eol=lf

*.py    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.ini   text eol=lf
Dockerfile      text eol=lf
.dockerignore   text eol=lf
.gitignore      text eol=lf
.gitattributes  text eol=lf

# 二进制文件不做任何转换
*.jpeg  binary
*.jpg   binary
*.png   binary
*.gif   binary
*.webp  binary
*.mp3   binary
*.wav   binary
