{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pink",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // Static assets are served directly from the edge.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // API routes and the manifest are handled by the Worker first.
    "run_worker_first": ["/api/*", "/manifest.webmanifest"]
  },

  // Runtime configuration.
  "vars": {
    "LLM_PRIMARY_BASE_URL": "https://open.bigmodel.cn/api/paas/v4",
    "LLM_PRIMARY_MODEL": "glm-4-flash",
    "LLM_FALLBACK_BASE_URL": "https://api.siliconflow.cn/v1",
    "LLM_FALLBACK_MODEL": "Qwen/Qwen2.5-7B-Instruct",
    "ASR_BASE_URL": "https://api.siliconflow.cn/v1",
    "ASR_MODEL": "FunAudioLLM/SenseVoiceSmall",
    "ALLOWED_ORIGIN": "https://ai.weidenglu.com"
  },

  "observability": {
    "enabled": true
  }
}