{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pink-room",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",

  // 静态资源：public/ 直接由 Cloudflare 边缘节点分发
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // /api/* 优先交给 Worker，其余路径交给静态资源，避免路由歧义
    "run_worker_first": ["/api/*"]
  },

  // 非敏感配置放这里；密钥由 Cloudflare 的 Secrets 注入
  "vars": {
    "LLM_BASE_URL": "https://apihub.agnes-ai.com/v1",
    "LLM_MODEL": "agnes-3.0-flash",
    "ASR_BASE_URL": "https://api.siliconflow.cn/v1",
    "ASR_MODEL": "FunAudioLLM/SenseVoiceSmall",
    "ALLOWED_ORIGIN": "https://ai.weidenglu.com"
  },

  "observability": {
    "enabled": true
  }
}